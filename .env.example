# ==============================================================================
# Master Environment Variables Template (Rename to .env before deployment)
# DO NOT COMMIT REAL PASSWORDS OR API KEYS TO GIT REPOSITORY
# ==============================================================================

# Database Settings (PostgreSQL)
POSTGRES_DB=food_recsys
POSTGRES_USER=recsys_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Backend Connection URL (Docker Container Network)
DATABASE_URL=postgresql+psycopg2://recsys_admin:your_secure_postgres_password_here@postgres:5432/food_recsys

# JWT Authentication & Cryptographic Keys
SECRET_KEY=generate_a_random_32_byte_hex_string_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=80

# Client Configuration
VITE_API_URL=http://localhost:8000/api/v1

